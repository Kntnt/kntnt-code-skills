#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Scaffold Kntnt's coding standard into a project.

Writes each requested module as its own on-demand file under
``agents.d/coding-<module>.md``, ensures ``AGENTS.md`` carries a
``## References`` entry pointing at each one, and ensures ``CLAUDE.md``
bridges to ``AGENTS.md`` with ``@AGENTS.md``.

The standard is reached on demand: an agent follows a References pointer
and reads only the modules a task needs, rather than paying for the whole
standard on every session. Override modules (WordPress over PHP, Gutenberg
blocks over TypeScript) carry a generated prerequisite + precedence header
so the override resolves however the file is reached. The concrete wiring
lives in MODULE_META here, so the source modules stay generic and portable.

The skill's ``SKILL.md`` is the source of truth for which modules exist and
which apply to a given project. This script executes the file work —
per-module file creation, surgical edits to existing AGENTS.md/CLAUDE.md —
so the calling agent doesn't recreate the logic every time. It does not
build a full AGENTS.md: when AGENTS.md is missing it writes a minimal one
(title + References) and tells the caller to run /agents-md to flesh it out.

Typical use:

    bin/scaffold \\
        --project-dir /path/to/new-project \\
        --skill-dir   /path/to/kntnt-code-skills/skills/coder \\
        --include     php,wordpress,typescript,wordpress-block

Order on the command line does not matter; the canonical order is imposed
internally so override relationships stay correct.

Exit codes:

    0   Scaffolding completed successfully.
    1   Bad arguments, missing module file, or sanity-check failed.
    2   One or more target ``agents.d/coding-<module>.md`` files already
        exist and were not overwritten. Stderr names them so the caller
        can decide what to do.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import NoReturn

# Canonical order. Later entries override earlier ones on points where they
# differ — see SKILL.md, step 4 of the flow. The order is also the
# precedence order written into AGENTS.md's References list, so the
# "last listed wins" tie-break in the generated headers stays correct.
CANONICAL_ORDER: list[str] = [
    "general",
    "php",
    "wordpress",
    "typescript",
    "wordpress-block",
    "javascript-vanilla",
    "python",
    "bash",
]

# Per-module wiring for the generated agents.d/ files. Keyed by module:
#   label     — human title in the generated H1.
#   read_when  — completes "Read before writing or changing <read_when>." in
#                both the file header and the AGENTS.md References line.
#   requires   — modules that must be read first because this one overrides
#                or builds on them; drives the prerequisite header and the
#                References co-load note. Empty for standalone modules.
MODULE_META: dict[str, dict[str, object]] = {
    "general": {"label": "General", "read_when": "any code", "requires": []},
    "php": {"label": "PHP", "read_when": "PHP", "requires": []},
    "wordpress": {
        "label": "WordPress",
        "read_when": "a WordPress plugin or theme",
        "requires": ["php"],
    },
    "typescript": {"label": "TypeScript", "read_when": "TypeScript", "requires": []},
    "wordpress-block": {
        "label": "WordPress Blocks",
        "read_when": "Gutenberg blocks",
        "requires": ["wordpress", "typescript"],
    },
    "javascript-vanilla": {
        "label": "Vanilla JavaScript",
        "read_when": "build-less browser JavaScript",
        "requires": [],
    },
    "python": {"label": "Python", "read_when": "Python", "requires": []},
    "bash": {"label": "Bash", "read_when": "Bash", "requires": []},
}

# Override modules get a verbatim prerequisite sentence in their header — the
# wording reads naturally per module, so it is stored rather than generated
# from `requires`. Every module with a non-empty `requires` has an entry.
OVERRIDE_HEADER: dict[str, str] = {
    "wordpress": "Read `coding-php.md` first; the rules below override parts of it.",
    "wordpress-block": (
        "Read `coding-wordpress.md` and `coding-typescript.md` first; the rules "
        "below override parts of TypeScript."
    ),
}

# Appended after the prerequisite line in every override module's header.
PRECEDENCE_LINE: str = (
    "On any conflict between this file and another, the file listed last in the "
    "References section of AGENTS.md wins."
)

# Fail loudly if the maps drift from CANONICAL_ORDER — a new module added to
# CANONICAL_ORDER without MODULE_META (or vice versa) is a bug, not a silent
# half-configuration. OVERRIDE_HEADER must cover exactly the modules that
# declare a `requires` list.
assert set(MODULE_META) == set(CANONICAL_ORDER), (
    "MODULE_META and CANONICAL_ORDER are out of sync"
)
assert set(OVERRIDE_HEADER) == {
    name for name, meta in MODULE_META.items() if meta["requires"]
}, "OVERRIDE_HEADER must cover exactly the modules with a non-empty `requires`"

# Markers we accept as evidence that a directory is a real project, before we
# start writing files into it. Generous — any one is enough.
PROJECT_MARKERS: list[str] = [
    ".git",
    "composer.json",
    "package.json",
]


class ScaffoldArgumentParser(argparse.ArgumentParser):
    """ArgumentParser that exits with code 1 on a usage error.

    argparse's default is exit code 2, but this script reserves 2 for
    "a target coding-standard file already exists". Mapping usage errors to 1
    keeps the bad-arguments case distinct from the exit code alone.
    """

    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        self.exit(1, f"{self.prog}: error: {message}\n")


def references_line(module: str) -> str:
    """Build the AGENTS.md References bullet for a module."""

    read_when = MODULE_META[module]["read_when"]
    requires = MODULE_META[module]["requires"]

    # Override/co-load modules carry a note so the reader pulls their
    # prerequisites too — the override cannot resolve without them.
    note = ""
    if requires:
        coload = " + ".join(f"`coding-{name}.md`" for name in requires)
        note = f" (also load {coload})"

    return (
        f"- `agents.d/coding-{module}.md` — read before writing or changing "
        f"{read_when}{note}"
    )


def build_module_file(module: str, body: str) -> str:
    """Assemble the on-demand file for one module.

    The generated H1 + read-when line (and, for override modules, the
    prerequisite + precedence lines) sit above the module body. The module's
    own leading heading is dropped so the generated H1 is the sole title.
    """

    label = MODULE_META[module]["label"]
    read_when = MODULE_META[module]["read_when"]

    # Drop the module's own first heading and any surrounding blank lines; the
    # generated H1 replaces it.
    lines = body.splitlines()
    while lines and lines[0].strip() == "":
        lines.pop(0)
    if lines and lines[0].lstrip().startswith("#"):
        lines.pop(0)
    while lines and lines[0].strip() == "":
        lines.pop(0)
    stripped_body = "\n".join(lines).rstrip() + "\n"

    # Build the generated header: title, read-when, then the override block
    # for modules that have prerequisites.
    header = [
        f"# Coding standard — {label}",
        "",
        f"Read before writing or changing {read_when}.",
    ]
    if module in OVERRIDE_HEADER:
        header += ["", OVERRIDE_HEADER[module], "", PRECEDENCE_LINE]
    header += ["", ""]

    return "\n".join(header) + stripped_body


def ensure_references(
    *, project_dir: Path, modules: list[str], dry_run: bool
) -> str:
    """Ensure AGENTS.md carries a References entry for each module.

    Creates a minimal AGENTS.md (title + References) when missing; otherwise
    inserts only the lines not already present, leaving the rest untouched.
    """

    agents_md = project_dir / "AGENTS.md"
    wanted = {module: references_line(module) for module in modules}

    # Case A: no AGENTS.md — write a minimal one. We deliberately do not build
    # out the rest of the file; that is /agents-md's job.
    if not agents_md.exists():
        title = project_dir.name or "Project"
        body = "\n".join(wanted[module] for module in modules)
        content = f"# {title}\n\n## References\n\n{body}\n"
        if dry_run:
            return (
                "[dry-run] would create AGENTS.md with References "
                "(run /agents-md to flesh it out)"
            )
        agents_md.write_text(content, encoding="utf-8")
        return "created minimal AGENTS.md with References — run /agents-md to flesh it out"

    existing = agents_md.read_text(encoding="utf-8")

    # Only add lines whose target file isn't already referenced.
    missing = [
        wanted[module]
        for module in modules
        if f"agents.d/coding-{module}.md" not in existing
    ]
    if not missing:
        return "AGENTS.md already references the coding standard (skipped)"

    text_lines = existing.splitlines()
    ref_index = next(
        (i for i, line in enumerate(text_lines) if line.strip().lower() == "## references"),
        -1,
    )

    # Case B: no References section — append one.
    if ref_index == -1:
        new = existing.rstrip() + "\n\n## References\n\n" + "\n".join(missing) + "\n"
        if dry_run:
            return "[dry-run] would add a References section to AGENTS.md"
        agents_md.write_text(new, encoding="utf-8")
        return "added a References section to AGENTS.md"

    # Case C: a References section exists — insert after its last bullet.
    insert_at = ref_index + 1
    cursor = ref_index + 1
    while cursor < len(text_lines) and not text_lines[cursor].startswith("## "):
        if text_lines[cursor].strip():
            insert_at = cursor + 1
        cursor += 1
    text_lines[insert_at:insert_at] = missing
    if dry_run:
        return "[dry-run] would add coding lines to AGENTS.md References"
    agents_md.write_text("\n".join(text_lines).rstrip() + "\n", encoding="utf-8")
    return "added coding lines to AGENTS.md References"


def ensure_bridge(*, project_dir: Path, dry_run: bool) -> str:
    """Ensure CLAUDE.md imports AGENTS.md with ``@AGENTS.md``.

    Claude Code reads CLAUDE.md, not AGENTS.md; the bridge is what makes the
    References (and everything they point to) reachable.
    """

    claude_md = project_dir / "CLAUDE.md"

    if not claude_md.exists():
        if dry_run:
            return "[dry-run] would create CLAUDE.md (@AGENTS.md bridge)"
        claude_md.write_text("@AGENTS.md\n", encoding="utf-8")
        return "created CLAUDE.md (@AGENTS.md bridge)"

    existing = claude_md.read_text(encoding="utf-8")
    if "@AGENTS.md" in existing:
        return "CLAUDE.md already bridges to AGENTS.md (skipped)"

    if dry_run:
        return "[dry-run] would add @AGENTS.md bridge to CLAUDE.md"
    claude_md.write_text("@AGENTS.md\n\n" + existing.lstrip(), encoding="utf-8")
    return "added @AGENTS.md bridge to CLAUDE.md"


def main() -> int:
    """Run the scaffolder end to end. Returns the process exit code."""

    # Parse the command line. ScaffoldArgumentParser maps any usage error to
    # exit code 1 (see the class docstring).
    parser = ScaffoldArgumentParser(
        description="Scaffold Kntnt's coding standard into a project.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--project-dir",
        type=Path,
        required=True,
        help="Path to the project root.",
    )
    parser.add_argument(
        "--skill-dir",
        type=Path,
        required=True,
        help="Path to this skill's folder (where the module files live).",
    )
    parser.add_argument(
        "--include",
        required=True,
        help=(
            "Comma-separated module names (e.g. 'php,wordpress,typescript'). "
            "'general' is always included."
        ),
    )
    parser.add_argument(
        "--touch-agents-md",
        action="store_true",
        help=(
            "Deprecated no-op: AGENTS.md is now always written (it holds the "
            "References). Accepted for backward compatibility."
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would happen without writing any files.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Skip the project-directory sanity check.",
    )
    args = parser.parse_args()

    project_dir: Path = args.project_dir.resolve()
    skill_dir: Path = args.skill_dir.resolve()
    requested = [part.strip() for part in args.include.split(",") if part.strip()]

    # Sanity-check the project directory unless --force is set. Refusing to
    # write into a random directory protects against typos.
    if not args.force:
        has_marker = any((project_dir / marker).exists() for marker in PROJECT_MARKERS)
        if not has_marker:
            markers = ", ".join(PROJECT_MARKERS)
            print(
                f"error: {project_dir} doesn't look like a project root "
                f"(no {markers}). Pass --force to override.",
                file=sys.stderr,
            )
            return 1

    # Validate the requested modules and put them in canonical order.
    unknown = [module for module in requested if module not in CANONICAL_ORDER]
    if unknown:
        print(
            f"error: unknown module(s): {', '.join(unknown)}. "
            f"Known modules: {', '.join(CANONICAL_ORDER)}.",
            file=sys.stderr,
        )
        return 1
    requested_set = set(requested)
    requested_set.add("general")
    ordered = [module for module in CANONICAL_ORDER if module in requested_set]

    # Read each module body. A missing file means the skill itself is broken —
    # fail loudly rather than silently producing a half-baked standard.
    bodies: dict[str, str] = {}
    for module in ordered:
        path = skill_dir / f"{module}.md"
        if not path.exists():
            print(f"error: module file missing: {path}", file=sys.stderr)
            return 1
        bodies[module] = path.read_text(encoding="utf-8")

    # Refuse to overwrite existing coding-standard files; the project's
    # snapshot is intentional and only re-scaffolded on purpose.
    agents_d = project_dir / "agents.d"
    clashes = [module for module in ordered if (agents_d / f"coding-{module}.md").exists()]
    if clashes:
        names = ", ".join(f"agents.d/coding-{module}.md" for module in clashes)
        print(
            f"existing coding-standard file(s) found: {names}\n"
            "refusing to overwrite. Move them aside or re-scaffold intentionally.",
            file=sys.stderr,
        )
        return 2

    # Write (or, on a dry run, describe) each module file.
    actions: list[str] = []
    for module in ordered:
        dest = agents_d / f"coding-{module}.md"
        if args.dry_run:
            actions.append(f"[dry-run] would write agents.d/coding-{module}.md")
            continue
        agents_d.mkdir(parents=True, exist_ok=True)
        dest.write_text(build_module_file(module, bodies[module]), encoding="utf-8")
        actions.append(f"wrote agents.d/coding-{module}.md")

    # Wire the References into AGENTS.md and the bridge into CLAUDE.md.
    actions.append(
        ensure_references(project_dir=project_dir, modules=ordered, dry_run=args.dry_run)
    )
    actions.append(ensure_bridge(project_dir=project_dir, dry_run=args.dry_run))

    # Report. One line per action.
    print("scaffold complete:")
    for action in actions:
        print(f"  - {action}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
