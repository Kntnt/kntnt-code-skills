#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Scaffold Kntnt's coding standard into a project.

Concatenates the requested module files from this skill into
``docs/coding-standards.md`` and wires the import into ``CLAUDE.md``
(and optionally ``AGENTS.md``).

The skill's ``SKILL.md`` is the source of truth for which modules exist
and which apply to a given project. This script just executes the file
work — concatenation, file creation, surgical edits to existing files —
so the calling agent doesn't have to recreate the logic every time.

Typical use:

    bin/scaffold \\
        --project-dir /path/to/new-project \\
        --skill-dir   /path/to/kntnt-code-skills/skills/coder \\
        --include     php,wordpress,typescript,wordpress-block

Order on the command line does not matter; the canonical order is
imposed internally so override relationships stay correct.

Exit codes:

    0   Scaffolding completed successfully.
    1   Bad arguments, missing module file, or sanity-check failed.
    2   ``docs/coding-standards.md`` already exists in the project and
        was not overwritten. Stderr contains its first 20 lines so the
        caller can decide what to do.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import NoReturn

# Canonical order in which modules appear in the assembled
# coding-standards.md. Later entries override earlier ones on points
# where they differ — see SKILL.md, step 4 of the flow.
CANONICAL_ORDER: list[str] = [
    "general",
    "php",
    "wordpress",
    "typescript",
    "wordpress-block",
    "javascript-vanilla",
    "python",
    "bash",
]

# Markers we accept as evidence that a directory is a real project,
# before we start writing files into it. The list is intentionally
# generous — if any one of these exists, the script proceeds.
PROJECT_MARKERS: list[str] = [
    ".git",
    "composer.json",
    "package.json",
]


class ScaffoldArgumentParser(argparse.ArgumentParser):
    """ArgumentParser that exits with code 1 on a usage error.

    argparse's default is exit code 2, but this script reserves 2 for
    "docs/coding-standards.md already exists". Mapping usage errors to 1
    keeps the bad-arguments case distinct so a caller can tell the two
    apart from the exit code alone.
    """

    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        self.exit(1, f"{self.prog}: error: {message}\n")


def insert_import(content: str) -> str:
    """Insert ``@docs/coding-standards.md`` into a CLAUDE.md / AGENTS.md.

    Strategy, in order:

    1. If a ``## Coding standards`` heading already exists, append the
       import on the first non-blank line beneath it.
    2. Otherwise, insert both the heading and the import after the first
       H1 (and any introductory paragraph that follows it).
    3. If there is no H1 at all, append the heading and the import at the
       end.

    Existing content is otherwise preserved.
    """

    lines = content.splitlines()

    # Strategy 1: an explicit "## Coding standards" heading already
    # exists — drop the import on the first non-blank line beneath it.
    for i, line in enumerate(lines):
        if line.strip().lower() == "## coding standards":
            insert_at = i + 1
            if insert_at < len(lines) and lines[insert_at].strip() == "":
                insert_at += 1

            # Append a trailing blank only when the next existing line
            # isn't already blank — avoids an ugly double blank.
            to_insert = ["@docs/coding-standards.md"]
            next_line = lines[insert_at] if insert_at < len(lines) else None
            if next_line is None or next_line.strip() != "":
                to_insert.append("")

            lines[insert_at:insert_at] = to_insert
            return "\n".join(lines).rstrip() + "\n"

    # Strategy 2: no heading — find the first H1 so a fresh section can be
    # inserted after it and its intro paragraph.
    h1_index = next((i for i, line in enumerate(lines) if line.startswith("# ")), -1)
    if h1_index == -1:
        # Strategy 3: no H1 either — append the section at the end.
        return (
            content.rstrip() + "\n\n## Coding standards\n\n@docs/coding-standards.md\n"
        )

    # Skip blank lines after the H1, then skip the intro paragraph if
    # there is one (a contiguous run of non-blank, non-heading lines).
    insert_at = h1_index + 1
    while insert_at < len(lines) and lines[insert_at].strip() == "":
        insert_at += 1
    while (
        insert_at < len(lines)
        and lines[insert_at].strip() != ""
        and not lines[insert_at].startswith("#")
    ):
        insert_at += 1

    # Drop the trailing blank from the new section when the next existing
    # line is already blank, so we don't end up with two blank lines.
    new_section = ["", "## Coding standards", "", "@docs/coding-standards.md", ""]
    next_existing = lines[insert_at] if insert_at < len(lines) else None
    if next_existing is not None and next_existing.strip() == "":
        new_section.pop()

    lines[insert_at:insert_at] = new_section
    return "\n".join(lines).rstrip() + "\n"


def touch_agent_file(
    *,
    project_dir: Path,
    filename: str,
    h1: str,
    template_text: str,
    dry_run: bool,
) -> str:
    """Create the agent file from the template, or surgically insert the
    coding-standards import into an existing one.

    Returns a one-line description of what it did (or would do, on a dry
    run) so the caller can report it verbatim.
    """

    agent_file = project_dir / filename

    # Case A: the file doesn't exist yet — copy the template, rewriting
    # the H1 for anything other than CLAUDE.md.
    if not agent_file.exists():
        content = (
            template_text
            if filename == "CLAUDE.md"
            else template_text.replace("# CLAUDE.md", h1, 1)
        )
        if dry_run:
            return f"[dry-run] would create {filename}"
        agent_file.write_text(content, encoding="utf-8")
        return f"created {filename}"

    existing = agent_file.read_text(encoding="utf-8")

    # Case B: the file exists and already imports the standard — leave it
    # alone.
    if "@docs/coding-standards.md" in existing:
        return f"{filename} already imports coding-standards.md (skipped)"

    # Case C: the file exists but doesn't import the standard — insert the
    # import surgically.
    if dry_run:
        return f"[dry-run] would update {filename}"
    agent_file.write_text(insert_import(existing), encoding="utf-8")
    return f"updated {filename}"


def main() -> int:
    """Run the scaffolder end to end. Returns the process exit code."""

    # Parse the command line. ScaffoldArgumentParser maps any usage error
    # to exit code 1 (see the class docstring).
    parser = ScaffoldArgumentParser(
        description="Scaffold Kntnt's coding standard into a project.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--project-dir",
        type=Path,
        required=True,
        help="Path to the project root.",
    )
    parser.add_argument(
        "--skill-dir",
        type=Path,
        required=True,
        help="Path to this skill's folder (where the module files live).",
    )
    parser.add_argument(
        "--include",
        required=True,
        help=(
            "Comma-separated module names (e.g. 'php,wordpress,typescript'). "
            "'general' is always included."
        ),
    )
    parser.add_argument(
        "--touch-agents-md",
        action="store_true",
        help="Also create or update AGENTS.md alongside CLAUDE.md.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would happen without writing any files.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Skip the project-directory sanity check.",
    )
    args = parser.parse_args()

    project_dir: Path = args.project_dir.resolve()
    skill_dir: Path = args.skill_dir.resolve()
    requested = [part.strip() for part in args.include.split(",") if part.strip()]

    # Sanity-check the project directory unless --force is set. Refusing to
    # write into a random directory protects Thomas from typos.
    if not args.force:
        has_marker = any((project_dir / marker).exists() for marker in PROJECT_MARKERS)
        if not has_marker:
            markers = ", ".join(PROJECT_MARKERS)
            print(
                f"error: {project_dir} doesn't look like a project root "
                f"(no {markers}). Pass --force to override.",
                file=sys.stderr,
            )
            return 1

    # Validate the requested modules and put them in canonical order.
    unknown = [module for module in requested if module not in CANONICAL_ORDER]
    if unknown:
        print(
            f"error: unknown module(s): {', '.join(unknown)}. "
            f"Known modules: {', '.join(CANONICAL_ORDER)}.",
            file=sys.stderr,
        )
        return 1
    requested_set = set(requested)
    requested_set.add("general")
    ordered = [module for module in CANONICAL_ORDER if module in requested_set]

    # Read each module from the skill folder. A missing file means the
    # skill itself is broken — fail loudly rather than silently producing a
    # half-baked standard.
    parts: list[str] = []
    for name in ordered:
        path = skill_dir / f"{name}.md"
        if not path.exists():
            print(f"error: module file missing: {path}", file=sys.stderr)
            return 1
        parts.append(path.read_text(encoding="utf-8"))

    coding_standards_text = "\n".join(parts).rstrip() + "\n"

    # Refuse to overwrite an existing docs/coding-standards.md; print its
    # head to stderr so the caller can decide what to do.
    target = project_dir / "docs" / "coding-standards.md"
    if target.exists():
        head = "\n".join(target.read_text(encoding="utf-8").splitlines()[:20])
        print(
            f"existing docs/coding-standards.md found at {target}.\n"
            f"first 20 lines:\n---\n{head}\n---\n"
            "refusing to overwrite. Move it aside or pick a different directory.",
            file=sys.stderr,
        )
        return 2

    # Write (or, on a dry run, describe) docs/coding-standards.md.
    actions: list[str] = []
    if args.dry_run:
        actions.append(
            f"[dry-run] would write docs/coding-standards.md "
            f"({len(coding_standards_text)} bytes, modules: {', '.join(ordered)})"
        )
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(coding_standards_text, encoding="utf-8")
        actions.append(
            f"wrote docs/coding-standards.md "
            f"({len(ordered)} modules: {', '.join(ordered)})"
        )

    # Load the CLAUDE.md template once; both CLAUDE.md and AGENTS.md are
    # derived from it.
    template_path = skill_dir / "templates" / "claude-md-template.md"
    if not template_path.exists():
        print(f"error: CLAUDE.md template missing: {template_path}", file=sys.stderr)
        return 1
    template_text = template_path.read_text(encoding="utf-8")

    # Touch CLAUDE.md always, and AGENTS.md only when asked. One action
    # line per file so the calling agent can quote the result verbatim.
    agent_files: list[tuple[str, str]] = [("CLAUDE.md", "# CLAUDE.md")]
    if args.touch_agents_md:
        agent_files.append(("AGENTS.md", "# AGENTS.md"))

    for filename, h1 in agent_files:
        actions.append(
            touch_agent_file(
                project_dir=project_dir,
                filename=filename,
                h1=h1,
                template_text=template_text,
                dry_run=args.dry_run,
            )
        )

    # Report. One line per action.
    print("scaffold complete:")
    for action in actions:
        print(f"  - {action}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
